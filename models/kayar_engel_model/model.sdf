<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="kayar_engel">
    <!--
      TEKNOFEST 2026 IKA - Kayar Engel
      Sartname 6.8: 1m genislik, 20 cm/s git-gel
      Hareket: kayar_engel_plugin.cc ile saglanir (derleme gerekir)
    -->
    <static>false</static>

    <!-- Sabit ray: joint referansi -->
    <link name="ray">
      <inertial>
        <mass>100.0</mass>
        <inertia>
          <ixx>75.0</ixx><iyy>0.008</iyy><izz>75.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- Hareketli engel -->
    <link name="engel">
      <pose>0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.52</ixx><iyy>0.02</iyy><izz>0.42</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="engel_visual">
        <geometry>
          <box><size>0.15 1.0 0.50</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/RedBright</name>
          </script>
        </material>
      </visual>
      <collision name="engel_collision">
        <geometry>
          <box><size>0.15 1.0 0.50</size></box>
        </geometry>
      </collision>

      <visual name="serit_visual">
        <pose>0 0 0.26 0 0 0</pose>
        <geometry>
          <box><size>0.16 1.0 0.03</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Yellow</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- Ray dunyaya sabit -->
    <joint name="ray_fix" type="fixed">
      <parent>world</parent>
      <child>ray</child>
    </joint>

    <!-- Engel kayma eklemi (Y ekseni boyunca) -->
    <joint name="engel_slide" type="prismatic">
      <parent>ray</parent>
      <child>engel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
          <effort>1000</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Hareket plugin'i: derlendikten sonra aktif olur -->
    <plugin name="kayar_engel_hareketi" filename="libkayar_engel_plugin.so">
      <speed>0.20</speed>
      <lower_limit>-1.5</lower_limit>
      <upper_limit>1.5</upper_limit>
    </plugin>

  </model>
</sdf>
