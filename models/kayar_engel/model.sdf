<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="kayar_engel">
    <static>false</static>

    <link name="engel">
      <gravity>false</gravity>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.0</ixx><iyy>5.0</iyy><izz>5.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="engel_visual">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box><size>0.15 1.0 0.50</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/RedBright</name>
          </script>
        </material>
      </visual>

      <collision name="engel_collision">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry>
          <box><size>0.15 1.0 0.50</size></box>
        </geometry>
      </collision>

      <visual name="serit_visual">
        <pose>0 0 0.51 0 0 0</pose>
        <geometry>
          <box><size>0.16 1.0 0.03</size></box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Yellow</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- Hareket plugin'i: modeli dogrudan hareket ettirir -->
    <plugin name="kayar_engel_hareketi" filename="libkayar_engel_plugin.so">
      <speed>0.20</speed>
      <lower_limit>-1.0</lower_limit>
      <upper_limit>1.0</upper_limit>
    </plugin>

  </model>
</sdf>
