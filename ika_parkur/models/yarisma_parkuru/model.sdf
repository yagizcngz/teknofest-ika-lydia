<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="yarisma_parkuru">
    <static>true</static>
    <link name="link">

      <collision name="zemin_col">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry><mesh><uri>model://yarisma_parkuru/zemin.dae</uri></mesh></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><ode><kp>500000.0</kp><kd>10.0</kd></ode></contact>
