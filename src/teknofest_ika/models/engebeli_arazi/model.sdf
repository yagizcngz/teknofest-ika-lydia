<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="engebeli_arazi">
    <static>true</static>

    <!-- Tumsek 1 - Alt genis kisim (20cm genis, 3cm yuksek, 3m uzun) -->
    <link name="t1_alt">
      <visual name="v"><pose>-1.20 0 0.015 0 0 0</pose>
        <geometry><box><size>0.20 3.0 0.03</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      <collision name="c"><pose>-1.20 0 0.015 0 0 0</pose>
        <geometry><box><size>0.20 3.0 0.03</size></box></geometry></collision>
    </link>
