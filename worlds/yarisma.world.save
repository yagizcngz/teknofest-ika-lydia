    <!--
      KAYAR ENGEL - Sartname 6.8
      Kukalardan sonra, sag taraftaki koridorun ust bolumu.

      KONUM AYARI:
      Eger engel hala yanlis yerdeyse asagidaki pose'u degistir:
        - x: ekranda yukari/asagi (kucultmek icin azalt, buyutmek icin artir)
        - y: ekranda sag/sol
        - Son sayi (yaw): engelin yonu
            0       = engel Y ekseninde hareket eder (ekranda sag-sol)
            1.5708  = engel X ekseninde hareket eder (ekranda yukari-asagi)

      Gazebo'da koordinat bulmak:
        Sol ust kosedeki "Move" araci secili iken fareyi parkur uzerine getir
        → Alt cubukta "Pos: x=... y=..." gozukur
    -->
    <include>
      <uri>model://kayar_engel</uri>
      <name>kayar_engel</name>
      <!-- Kukalardan sonra - Gazebo'dan alinan kesin koordinatlar -->
      <pose>-0.013666 9.452664 0.052533 0 0 0</pose>
    </include>

      <include>
